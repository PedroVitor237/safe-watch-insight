// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TECHNICIAN
  SUPERVISOR
  AUDITOR
}

enum StandardType {
  NR
  NBR
  NT
  OTHER
}

enum InspectionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SyncStatus {
  PENDING
  SYNCING
  SYNCED
  ERROR
}

enum ChecklistVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum InspectionSnapshotOrigin {
  INSPECTION_CREATION
  LEGACY_BACKFILL
}

enum InspectionSnapshotIntegrityStatus {
  VERIFIED
  UNVERIFIED_LEGACY
}

enum ResponseStatus {
  COMPLIANT
  NON_COMPLIANT
  NOT_APPLICABLE
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NonConformityStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  OVERDUE
}

enum CorrectiveActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  email     String    @unique
  password  String
  role      UserRole
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  companies   Company[]
  checklists  Checklist[]
  inspections Inspection[]
  reports     Report[]

  checklistVersionsCreated   ChecklistVersion[] @relation("ChecklistVersionCreatedBy")
  checklistVersionsPublished ChecklistVersion[] @relation("ChecklistVersionPublishedBy")

  @@index([role])
  @@index([deletedAt])
}

model Company {
  id            String    @id @default(uuid()) @db.Uuid
  corporateName String
  tradeName     String?
  cnpj          String?   @unique
  cnae          String
  riskLevel     Int
  employeeCount Int
  address       String?
  notes         String?
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  createdBy   User         @relation(fields: [createdById], references: [id])
  inspections Inspection[]

  @@index([createdById])
  @@index([cnpj])
  @@index([deletedAt])
}

model Checklist {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String?
  isTemplate  Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdBy   User                          @relation(fields: [createdById], references: [id])
  items       ChecklistItem[]
  versions    ChecklistVersion[]
  inspections Inspection[]
  snapshots   InspectionChecklistSnapshot[] @relation("SnapshotSourceChecklist")

  @@index([createdById])
  @@index([isTemplate])
  @@index([isActive])
  @@index([deletedAt])
}

model ChecklistItem {
  id          String  @id @default(uuid()) @db.Uuid
  checklistId String  @db.Uuid
  description String
  orderIndex  Int
  isRequired  Boolean @default(true)

  checklist     Checklist                @relation(fields: [checklistId], references: [id])
  standards     ChecklistItemStandard[]
  responses     InspectionResponse[]
  versionItems  ChecklistVersionItem[]   @relation("VersionItemSourceChecklistItem")
  snapshotItems InspectionSnapshotItem[] @relation("SnapshotItemSourceChecklistItem")

  @@unique([checklistId, orderIndex])
  @@index([checklistId])
}

model Standard {
  id          String       @id @default(uuid()) @db.Uuid
  type        StandardType
  code        String       @unique
  title       String
  summary     String?
  officialUrl String?
  isActive    Boolean      @default(true)

  checklistItems          ChecklistItemStandard[]
  checklistVersionItems   ChecklistVersionItemStandard[]
  inspectionSnapshotItems InspectionSnapshotItemStandard[]

  @@index([type])
  @@index([code])
  @@index([isActive])
}

model ChecklistItemStandard {
  checklistItemId String @db.Uuid
  standardId      String @db.Uuid

  checklistItem ChecklistItem @relation(fields: [checklistItemId], references: [id])
  standard      Standard      @relation(fields: [standardId], references: [id])

  @@id([checklistItemId, standardId])
  @@index([standardId])
}

model ChecklistVersion {
  id                   String                 @id @default(uuid()) @db.Uuid
  checklistId          String                 @db.Uuid
  versionNumber        Int
  status               ChecklistVersionStatus @default(DRAFT)
  title                String
  description          String?
  contentSchemaVersion Int                    @default(1)
  contentHash          String?                @db.Char(64)
  createdById          String                 @db.Uuid
  publishedById        String?                @db.Uuid
  publishedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Restrict)
  createdBy   User      @relation("ChecklistVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy User?     @relation("ChecklistVersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)

  items       ChecklistVersionItem[]
  inspections Inspection[]
  snapshots   InspectionChecklistSnapshot[]

  @@unique([checklistId, versionNumber])
  @@index([checklistId, status])
  @@index([status])
  @@index([publishedAt])
}

model ChecklistVersionItem {
  id                    String   @id @default(uuid()) @db.Uuid
  checklistVersionId    String   @db.Uuid
  sourceVersionItemId   String?  @db.Uuid
  sourceChecklistItemId String?  @db.Uuid
  description           String
  orderIndex            Int
  isRequired            Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  checklistVersion    ChecklistVersion               @relation(fields: [checklistVersionId], references: [id], onDelete: Restrict)
  sourceVersionItem   ChecklistVersionItem?          @relation("VersionItemLineage", fields: [sourceVersionItemId], references: [id], onDelete: Restrict)
  derivedVersionItems ChecklistVersionItem[]         @relation("VersionItemLineage")
  sourceChecklistItem ChecklistItem?                 @relation("VersionItemSourceChecklistItem", fields: [sourceChecklistItemId], references: [id], onDelete: Restrict)
  standards           ChecklistVersionItemStandard[]
  snapshotItems       InspectionSnapshotItem[]

  @@unique([checklistVersionId, orderIndex])
  @@index([checklistVersionId])
  @@index([sourceVersionItemId])
  @@index([sourceChecklistItemId])
}

model ChecklistVersionItemStandard {
  checklistVersionItemId String       @db.Uuid
  standardId             String       @db.Uuid
  type                   StandardType
  code                   String
  title                  String
  summary                String?
  officialUrl            String?

  checklistVersionItem ChecklistVersionItem @relation(fields: [checklistVersionItemId], references: [id], onDelete: Restrict)
  standard             Standard             @relation(fields: [standardId], references: [id], onDelete: Restrict)

  @@id([checklistVersionItemId, standardId])
  @@index([standardId])
  @@index([code])
}

model Inspection {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @db.Uuid
  companyId          String           @db.Uuid
  checklistId        String           @db.Uuid
  checklistVersionId String?          @db.Uuid
  inspectionDate     DateTime
  status             InspectionStatus @default(PLANNED)
  syncStatus         SyncStatus       @default(SYNCED)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  user             User                         @relation(fields: [userId], references: [id])
  company          Company                      @relation(fields: [companyId], references: [id])
  checklist        Checklist                    @relation(fields: [checklistId], references: [id])
  checklistVersion ChecklistVersion?            @relation(fields: [checklistVersionId], references: [id], onDelete: Restrict)
  snapshot         InspectionChecklistSnapshot?
  responses        InspectionResponse[]
  evidence         Evidence[]
  report           Report?

  @@index([userId])
  @@index([companyId])
  @@index([checklistId])
  @@index([checklistVersionId])
  @@index([inspectionDate])
  @@index([status])
  @@index([syncStatus])
  @@index([deletedAt])
}

model InspectionResponse {
  id              String         @id @default(uuid()) @db.Uuid
  inspectionId    String         @db.Uuid
  checklistItemId String?        @db.Uuid
  snapshotItemId  String?        @db.Uuid
  status          ResponseStatus
  observation     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  inspection    Inspection              @relation(fields: [inspectionId], references: [id])
  checklistItem ChecklistItem?          @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)
  snapshotItem  InspectionSnapshotItem? @relation(fields: [snapshotItemId], references: [id], onDelete: Restrict)
  nonConformity NonConformity?

  @@unique([inspectionId, checklistItemId])
  @@unique([inspectionId, snapshotItemId])
  @@index([inspectionId])
  @@index([checklistItemId])
  @@index([snapshotItemId])
  @@index([status])
}

model InspectionChecklistSnapshot {
  id                       String                            @id @default(uuid()) @db.Uuid
  inspectionId             String                            @unique @db.Uuid
  sourceChecklistId        String                            @db.Uuid
  sourceChecklistVersionId String                            @db.Uuid
  sourceVersionNumber      Int
  title                    String
  description              String?
  isTemplate               Boolean
  snapshotSchemaVersion    Int                               @default(1)
  contentHash              String                            @db.Char(64)
  origin                   InspectionSnapshotOrigin
  integrityStatus          InspectionSnapshotIntegrityStatus
  capturedAt               DateTime                          @default(now())

  inspection             Inspection               @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  sourceChecklist        Checklist                @relation("SnapshotSourceChecklist", fields: [sourceChecklistId], references: [id], onDelete: Restrict)
  sourceChecklistVersion ChecklistVersion         @relation(fields: [sourceChecklistVersionId], references: [id], onDelete: Restrict)
  items                  InspectionSnapshotItem[]

  @@index([sourceChecklistId])
  @@index([sourceChecklistVersionId])
  @@index([origin])
  @@index([integrityStatus])
}

model InspectionSnapshotItem {
  id                    String  @id @default(uuid()) @db.Uuid
  snapshotId            String  @db.Uuid
  sourceVersionItemId   String  @db.Uuid
  sourceChecklistItemId String? @db.Uuid
  description           String
  orderIndex            Int
  isRequired            Boolean @default(true)

  snapshot            InspectionChecklistSnapshot      @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  sourceVersionItem   ChecklistVersionItem             @relation(fields: [sourceVersionItemId], references: [id], onDelete: Restrict)
  sourceChecklistItem ChecklistItem?                   @relation("SnapshotItemSourceChecklistItem", fields: [sourceChecklistItemId], references: [id], onDelete: Restrict)
  standards           InspectionSnapshotItemStandard[]
  responses           InspectionResponse[]

  @@unique([snapshotId, orderIndex])
  @@index([snapshotId])
  @@index([sourceVersionItemId])
  @@index([sourceChecklistItemId])
}

model InspectionSnapshotItemStandard {
  snapshotItemId String       @db.Uuid
  standardId     String       @db.Uuid
  type           StandardType
  code           String
  title          String
  summary        String?
  officialUrl    String?

  snapshotItem InspectionSnapshotItem @relation(fields: [snapshotItemId], references: [id], onDelete: Restrict)
  standard     Standard               @relation(fields: [standardId], references: [id], onDelete: Restrict)

  @@id([snapshotItemId, standardId])
  @@index([standardId])
  @@index([code])
}

model NonConformity {
  id                   String              @id @default(uuid()) @db.Uuid
  inspectionResponseId String              @unique @db.Uuid
  description          String
  severity             Severity
  dueDate              DateTime?
  status               NonConformityStatus @default(OPEN)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  inspectionResponse InspectionResponse @relation(fields: [inspectionResponseId], references: [id])
  correctiveActions  CorrectiveAction[]
  evidence           Evidence[]

  @@index([severity])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
}

model CorrectiveAction {
  id              String                 @id @default(uuid()) @db.Uuid
  nonConformityId String                 @db.Uuid
  description     String
  why             String?
  location        String?
  responsible     String?
  dueDate         DateTime?
  method          String?
  estimatedCost   String?
  status          CorrectiveActionStatus @default(PENDING)
  completedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?

  nonConformity NonConformity @relation(fields: [nonConformityId], references: [id])

  @@index([nonConformityId])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
}

model Evidence {
  id              String    @id @default(uuid()) @db.Uuid
  inspectionId    String?   @db.Uuid
  nonConformityId String?   @db.Uuid
  storageUrl      String
  fileName        String
  mimeType        String
  fileSize        BigInt
  caption         String?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  inspection    Inspection?    @relation(fields: [inspectionId], references: [id])
  nonConformity NonConformity? @relation(fields: [nonConformityId], references: [id])

  @@index([inspectionId])
  @@index([nonConformityId])
  @@index([mimeType])
  @@index([deletedAt])
}

model Report {
  id            String   @id @default(uuid()) @db.Uuid
  inspectionId  String   @unique @db.Uuid
  generatedById String   @db.Uuid
  version       Int      @default(1)
  generatedAt   DateTime @default(now())
  observations  String?

  inspection  Inspection @relation(fields: [inspectionId], references: [id])
  generatedBy User       @relation(fields: [generatedById], references: [id])

  @@index([generatedById])
  @@index([generatedAt])
}
