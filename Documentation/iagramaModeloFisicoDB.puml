@startuml
title Modelo Físico - Safe Watch Insight

hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam classAttributeIconSize 0

entity "User" as User {
  * id : UUID <<PK>>
  --
  email : TEXT <<UNIQUE>>
  password : TEXT
  role : UserRole
}

entity "Company" as Company {
  * id : UUID <<PK>>
  --
  createdById : UUID <<FK>>
  corporateName : TEXT
  cnpj : TEXT <<UNIQUE>>
}

entity "Checklist" as Checklist {
  * id : UUID <<PK>>
  --
  createdById : UUID <<FK>>
  title : TEXT
  description : TEXT
  isTemplate : BOOLEAN
  isActive : BOOLEAN
  deletedAt : TIMESTAMP
}

entity "ChecklistVersion" as ChecklistVersion {
  * id : UUID <<PK>>
  --
  checklistId : UUID <<FK>>
  versionNumber : INTEGER
  status : ChecklistVersionStatus
  title : TEXT
  description : TEXT
  contentSchemaVersion : INTEGER
  contentHash : CHAR(64)
  createdById : UUID <<FK>>
  publishedById : UUID <<FK>>
  publishedAt : TIMESTAMP
}

entity "ChecklistVersionItem" as ChecklistVersionItem {
  * id : UUID <<PK>>
  --
  checklistVersionId : UUID <<FK>>
  sourceVersionItemId : UUID <<FK, NULL>>
  sourceChecklistItemId : UUID <<FK, NULL>>
  description : TEXT
  orderIndex : INTEGER
  isRequired : BOOLEAN
}

entity "ChecklistVersionItemStandard" as ChecklistVersionItemStandard {
  * checklistVersionItemId : UUID <<PK, FK>>
  * standardId : UUID <<PK, FK>>
  --
  type : StandardType
  code : TEXT
  title : TEXT
  summary : TEXT
  officialUrl : TEXT
}

entity "Standard" as Standard {
  * id : UUID <<PK>>
  --
  type : StandardType
  code : TEXT <<UNIQUE>>
  title : TEXT
  summary : TEXT
  officialUrl : TEXT
  isActive : BOOLEAN
}

entity "Inspection" as Inspection {
  * id : UUID <<PK>>
  --
  userId : UUID <<FK>>
  companyId : UUID <<FK>>
  checklistId : UUID <<FK>>
  checklistVersionId : UUID <<FK, NULL>>
  inspectionDate : TIMESTAMP
  status : InspectionStatus
  syncStatus : SyncStatus
  notes : TEXT
  deletedAt : TIMESTAMP
}

entity "InspectionChecklistSnapshot" as InspectionChecklistSnapshot {
  * id : UUID <<PK>>
  --
  inspectionId : UUID <<UNIQUE, FK>>
  sourceChecklistId : UUID <<FK>>
  sourceChecklistVersionId : UUID <<FK>>
  sourceVersionNumber : INTEGER
  title : TEXT
  description : TEXT
  isTemplate : BOOLEAN
  snapshotSchemaVersion : INTEGER
  contentHash : CHAR(64)
  origin : InspectionSnapshotOrigin
  integrityStatus : InspectionSnapshotIntegrityStatus
  capturedAt : TIMESTAMP
}

entity "InspectionSnapshotItem" as InspectionSnapshotItem {
  * id : UUID <<PK>>
  --
  snapshotId : UUID <<FK>>
  sourceVersionItemId : UUID <<FK>>
  sourceChecklistItemId : UUID <<FK, NULL>>
  description : TEXT
  orderIndex : INTEGER
  isRequired : BOOLEAN
}

entity "InspectionSnapshotItemStandard" as InspectionSnapshotItemStandard {
  * snapshotItemId : UUID <<PK, FK>>
  * standardId : UUID <<PK, FK>>
  --
  type : StandardType
  code : TEXT
  title : TEXT
  summary : TEXT
  officialUrl : TEXT
}

entity "InspectionResponse" as InspectionResponse {
  * id : UUID <<PK>>
  --
  inspectionId : UUID <<FK>>
  snapshotItemId : UUID <<FK, NULL>>
  checklistItemId : UUID <<FK, NULL, LEGACY>>
  status : ResponseStatus
  observation : TEXT
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

entity "NonConformity" as NonConformity {
  * id : UUID <<PK>>
  --
  inspectionResponseId : UUID <<UNIQUE, FK>>
  description : TEXT
  severity : Severity
  status : NonConformityStatus
}

entity "CorrectiveAction" as CorrectiveAction {
  * id : UUID <<PK>>
  --
  nonConformityId : UUID <<FK>>
  description : TEXT
  status : CorrectiveActionStatus
}

entity "Evidence" as Evidence {
  * id : UUID <<PK>>
  --
  inspectionId : UUID <<FK, NULL>>
  nonConformityId : UUID <<FK, NULL>>
  storageUrl : TEXT
}

entity "Report" as Report {
  * id : UUID <<PK>>
  --
  inspectionId : UUID <<UNIQUE, FK>>
  generatedById : UUID <<FK>>
  version : INTEGER
}

User ||--o{ Company
User ||--o{ Checklist
User ||--o{ ChecklistVersion : creates/publishes
User ||--o{ Inspection
Company ||--o{ Inspection
Checklist ||--|{ ChecklistVersion
ChecklistVersion ||--o{ ChecklistVersionItem
ChecklistVersionItem ||--o{ ChecklistVersionItemStandard
Standard ||--o{ ChecklistVersionItemStandard
Checklist ||--o{ Inspection
ChecklistVersion ||--o{ Inspection
Inspection ||--|| InspectionChecklistSnapshot
Checklist ||--o{ InspectionChecklistSnapshot
ChecklistVersion ||--o{ InspectionChecklistSnapshot
InspectionChecklistSnapshot ||--o{ InspectionSnapshotItem
ChecklistVersionItem ||--o{ InspectionSnapshotItem
InspectionSnapshotItem ||--o{ InspectionSnapshotItemStandard
Standard ||--o{ InspectionSnapshotItemStandard
Inspection ||--o{ InspectionResponse
InspectionSnapshotItem ||--o{ InspectionResponse
InspectionResponse ||--o| NonConformity
NonConformity ||--o{ CorrectiveAction
Inspection ||--o{ Evidence
NonConformity ||--o{ Evidence
Inspection ||--o| Report

note right of ChecklistVersion
  UNIQUE(checklistId, versionNumber)
  UNIQUE parcial: um DRAFT/checklist
  CHECK de estado de publicação
end note

note right of InspectionChecklistSnapshot
  UNIQUE(inspectionId)
  conteúdo histórico imutável
end note

note right of InspectionResponse
  UNIQUE(inspectionId, snapshotItemId)
  snapshotItemId é autoritativo
end note

@enduml
