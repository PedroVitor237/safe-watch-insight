note as Integridade
  PK composta = par de FKs nas três associações.
  versionNumber único com checklistId.
  orderIndex único com o contêiner.
  Resposta: snapshotItemId OR checklistItemId (inclusivo).
  Evidência: inspectionId XOR nonConformityId.
  Inspection admite zero ou um snapshot no banco.
  Um DRAFT/checklist: UNIQUE parcial SQL.
  Checklist oficial: template e proprietário NULL.
  FKs: ON DELETE RESTRICT; ON UPDATE CASCADE nas migrations.
  Checklist.createdById: schema gera SET NULL; SQL mantém RESTRICT.
  Sem trigger SQL de imutabilidade ou de updatedAt.
end note

enum UserRole {
  ADMIN
  TECHNICIAN
  SUPERVISOR
  AUDITOR
}

enum StandardType {
  NR
  NBR
  NT
  OTHER
}

enum InspectionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SyncStatus {
  PENDING
  SYNCING
  SYNCED
  ERROR
}

enum OfflineOperationType {
  SAVE_INSPECTION_RESPONSE
  FINISH_INSPECTION
}

enum ChecklistVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum InspectionSnapshotOrigin {
  INSPECTION_CREATION
  LEGACY_BACKFILL
}

enum InspectionSnapshotIntegrityStatus {
  VERIFIED
  UNVERIFIED_LEGACY
}

enum ResponseStatus {
  COMPLIANT
  NON_COMPLIANT
  NOT_APPLICABLE
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NonConformityStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  OVERDUE
}

enum CorrectiveActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

note right of ChecklistVersion
  ChecklistVersion_versionNumber_check
  "versionNumber" > 0
end note

note right of ChecklistVersion
  ChecklistVersion_contentSchemaVersion_check
  "contentSchemaVersion" >= 0
end note

note right of ChecklistVersion
  ChecklistVersion_contentHash_check
  "contentHash" IS NULL OR "contentHash" ~ '^[0-9a-f]{64}$'
end note

note right of ChecklistVersionItem
  ChecklistVersionItem_orderIndex_check
  "orderIndex" > 0
end note

note right of InspectionChecklistSnapshot
  InspectionChecklistSnapshot_sourceVersionNumber_check
  "sourceVersionNumber" > 0
end note

note right of InspectionChecklistSnapshot
  InspectionChecklistSnapshot_schemaVersion_check
  "snapshotSchemaVersion" >= 0
end note

note right of InspectionChecklistSnapshot
  InspectionChecklistSnapshot_contentHash_check
  "contentHash" ~ '^[0-9a-f]{64}$'
end note

note right of InspectionSnapshotItem
  InspectionSnapshotItem_orderIndex_check
  "orderIndex" > 0
end note

note right of InspectionResponse
  InspectionResponse_itemReference_check
  "snapshotItemId" IS NOT NULL OR "checklistItemId" IS NOT NULL
end note

note right of Evidence
  Evidence_exactly_one_historical_context_check
  num_nonnulls("inspectionId", "nonConformityId") = 1
end note

note right of OfflineSyncOperation
  OfflineSyncOperation_payloadHash_check
  "payloadHash" ~ '^[0-9a-f]{64}$'
end note

note right of Checklist
  Checklist_ownership_check
  ("isOfficial" AND "createdById" IS NULL AND "isTemplate") OR (NOT "isOfficial" AND "createdById" IS NOT NULL)
end note

note right of ChecklistVersion
  ChecklistVersion_publicationState_check
  ("status" = 'DRAFT' AND "publishedById" IS NULL AND "publishedAt" IS NULL AND "contentHash" IS NULL) OR ( "status" IN ('PUBLISHED', 'RETIRED') AND ("publishedById" IS NOT NULL OR "createdById" IS NULL) AND "publishedAt" IS NOT NULL AND "contentHash" IS NOT NULL )
end note

note as Defaults
  UUIDs sem default SQL; uuid() é Prisma.
  OfflineSyncOperation.id é fornecido pelo cliente.
  updatedAt não tem default SQL; gestão @updatedAt no Prisma.
  DateTime = TIMESTAMP(3) sem fuso horário.
  Hashes = CHAR(64) hexadecimal minúsculo.
end note

@enduml
